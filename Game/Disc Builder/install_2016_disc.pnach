gametitle=FFXI 2016 install disc (b52): Adoulin INSTALL.ELF (CRC 0EA2DC0B) as installer; boots the 2016 host when installed
// I1: skip the copy of the locked FFXI_POL.ENC from the PlayOnline viewer partition (nothing is decrypted)
patch=2,EE,002B97D0,word,00001021
// I2: same, repair path
patch=2,EE,003055D0,word,00001021
// J3: no FFXI data on the drive -> state 0x0C (install) instead of 0x12 ("not installed")
patch=2,EE,00306838,word,2405000C
// J4: install step 3: every set ROM..ROM9 is installed (slti at,a1,8 -> 0)
patch=2,EE,002E93B8,word,28A10000
// J5: same
patch=2,EE,002E93C8,word,28A10000
// J6: the size pass sizes every set
patch=2,EE,002BBC90,word,2A410000
// N: size pass per-set size table alloc (bytes+3)<<2 -> bytes+3 (else no room for the unpack window)
patch=2,EE,002BBB90,word,00402021
// K1: YmPad::Update jal 0x1542B0 -> pad_hook (reads L1 only: held at start = show the reinstall question; never presses anything)
patch=2,EE,00154B40,word,0C106CE0
// K3: decision point -> decide (DONE=1, UIPTR=s0, then lb v0,0x30(s0); li a2,1)
patch=2,EE,003067CC,word,0C106CEB
// K3: nop
patch=2,EE,003067D0,word,00000000
// K2: "already installed" -> installed (2016 marker -> SetState(33) = restart into the host; else the reinstall screen)
patch=2,EE,003067F4,word,08106CF2
// K2: nop
patch=2,EE,003067F8,word,00000000
// M1: title screen (state 6) -> the menu is skipped: once the title is up, choice = "Start Installation" (sb zero,1384(s0))
patch=2,EE,003062B8,word,A2000568
// M1: nop
patch=2,EE,003062BC,word,00000000
// M1: nop (no button test)
patch=2,EE,003062C0,word,00000000
// M1: nop
patch=2,EE,003062C4,word,00000000
// M1: nop
patch=2,EE,003062C8,word,00000000
// M1: nop
patch=2,EE,003062CC,word,00000000
// M1: nop
patch=2,EE,003062D0,word,00000000
// M1: nop (no menu sound)
patch=2,EE,003062D4,word,00000000
// M1: nop
patch=2,EE,003062D8,word,00000000
// M1: SetState(9) (start installation: installed -> the game, new drive -> install) instead of SetState(7) (the menu)
patch=2,EE,003062EC,word,24050009
// R: SetState jump table entry 32 ("Restart PlayOnline Viewer? / No = power down") -> the entry of 33 (restart now): after "Installation complete" OK the host starts
patch=2,EE,0052B050,word,00305C60
